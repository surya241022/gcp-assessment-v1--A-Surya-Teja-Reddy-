config {
  type: "table",
  schema: "silver",
  name: "sales_enriched",
  description: "Cleaned, validated, and enriched sales data from the Bronze layer.",
  tags: ["silver", "sales"]
}

SELECT DISTINCT
    TRIM(CAST(order_id AS STRING)) AS order_id,

    SAFE_CAST(order_date AS DATE) AS order_date,

    TRIM(CAST(store_id AS STRING)) AS store_id,

    TRIM(CAST(product_id AS STRING)) AS product_id,

    TRIM(product_name) AS product_name,

    INITCAP(TRIM(category)) AS category,

    SAFE_CAST(quantity AS INT64) AS quantity,

    SAFE_CAST(unit_price AS NUMERIC) AS unit_price,

    INITCAP(TRIM(region)) AS region,

    SAFE_CAST(quantity AS NUMERIC)
        * SAFE_CAST(unit_price AS NUMERIC) AS revenue

FROM ${ref("sales_raw")}

WHERE order_id IS NOT NULL
  AND TRIM(CAST(order_id AS STRING)) != ''

  AND order_date IS NOT NULL

  AND product_id IS NOT NULL
  AND TRIM(CAST(product_id AS STRING)) != ''

  AND product_name IS NOT NULL
  AND TRIM(product_name) != ''

  AND category IS NOT NULL
  AND TRIM(category) != ''

  AND quantity IS NOT NULL
  AND quantity > 0

  AND unit_price IS NOT NULL
  AND unit_price >= 0

  AND region IS NOT NULL
  AND TRIM(region) != ''