config {
  type: "table",
  schema: "gold",
  name: "dim_product",
  description: "Product dimension derived from the Silver sales dataset.",
  tags: ["gold", "dimension", "product"]
}

SELECT
    product_id,
    ANY_VALUE(product_name) AS product_name,
    ANY_VALUE(category) AS category
FROM ${ref("sales_enriched")}
GROUP BY product_id