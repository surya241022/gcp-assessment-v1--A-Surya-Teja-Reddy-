config {
  type: "table",
  schema: "gold",
  name: "fact_sales",
  description: "Sales fact table containing transactional sales measures and dimensional keys.",
  tags: ["gold", "fact", "sales"]
}

SELECT
    order_id,

    order_date AS date_key,

    store_id,

    product_id,

    category,

    region,

    quantity,

    unit_price,

    revenue

FROM ${ref("sales_enriched")}